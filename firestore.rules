rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Phase 2: Entity Validations
    function isValidUser(data) {
      return (data.get('email', '') is string)
        && (data.get('uid', '') is string)
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 256))
        && (!('dreamUniversity' in data) || (data.dreamUniversity is string && data.dreamUniversity.size() <= 256))
        && (!('ambisType' in data) || (data.ambisType in ['Si Ambis', 'Penganut SKS', 'Pasrah']))
        && (!('wishlistedQuestions' in data) || data.wishlistedQuestions is list)
        && (!('createdAt' in data) || (data.createdAt is timestamp || data.createdAt is string))
        && (!('updatedAt' in data) || (data.updatedAt is timestamp || data.updatedAt is string));
    }

    function isValidPlaylist(data) {
      return (data.title is string && data.title.size() <= 100)
        && (data.slug is string && data.slug.size() <= 100)
        && (data.mode in ['workflow', 'normal'])
        && (data.creatorId is string)
        && (!('description' in data) || data.description is string);
    }

    // --- MATCH BLOCKS ---

    match /users/{userId} {
      allow read: if isOwner(userId);
      
      // Menggabungkan create dan update
      allow write: if isOwner(userId) 
                   && isValidUser(request.resource.data)
                   && (request.method == 'create' || (
                     // Saat update, pastikan email tidak berubah jika dikirim
                     (!('email' in request.resource.data) || request.resource.data.email == resource.data.email)
                   ));
    }

    match /questions/{questionId} {
      allow get: if isSignedIn() && isValidId(questionId);
      allow list: if isSignedIn();
      allow write: if false;
    }

    match /users/{userId}/vocabs/{vocabId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidId(vocabId) && isVerified();
    }

    match /users/{userId}/wishlist/{wishlistId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidId(wishlistId) && isVerified();
    }

    match /users/{userId}/history/{historyId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(historyId) && isVerified();
    }

    match /users/{userId}/progress/{subtestId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidId(subtestId) && isVerified();
    }

    match /subtest_sessions/{sessionId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }

    match /chats/{chatId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /studyPaths/{pathId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /studyPathTasks/{taskId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /playlists/{playlistId} {
      allow read, list: if true;
      allow create: if isVerified() && request.resource.data.creatorId == request.auth.uid && isValidPlaylist(request.resource.data);
      allow update, delete: if isOwner(resource.data.creatorId) && isValidPlaylist(request.resource.data);
      
      match /items/{itemId} {
        allow read, list: if true;
        allow write: if isOwner(get(/databases/$(database)/documents/playlists/$(playlistId)).data.creatorId) && isVerified();
      }
    }
  }
}